.app-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: #20232a;
  font-family: Arial, sans-serif;
  color: #fff;
}

.login-box,
.chat-box {
  background: #2c2f36;
  padding: 20px;
  border-radius: 10px;
  width: 380px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
}

.login-box h2,
.chat-box header h2 {
  margin-bottom: 20px;
  text-align: center;
}

.login-box input {
  width: 100%;
  padding: 12px;
  margin-bottom: 12px;
  border: none;
  border-radius: 6px;
}

.login-box button {
  background: #61dafb;
  border: none;
  padding: 12px;
  border-radius: 6px;
  cursor: pointer;
  width: 100%;
  font-weight: bold;
  transition: background 0.3s;
}

.login-box button:hover {
  background: #21a1f1;
}

.chat-box {
  display: flex;
  flex-direction: column;
  height: 550px;
}

.chat-box header {
  border-bottom: 1px solid #444;
  padding-bottom: 10px;
  margin-bottom: 10px;
}

.messages {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.message {
  padding: 8px 12px;
  border-radius: 6px;
  background: #3a3f47;
  max-width: 80%;
}

.message.self {
  background: #4caf50;
  align-self: flex-end;
}

.message.system {
  background: #ff9800;
  align-self: center;
  font-style: italic;
}

.input-box {
  display: flex;
  gap: 10px;
}

.input-box input {
  flex: 1;
  padding: 12px;
  border-radius: 6px;
  border: none;
}

.input-box button {
  background: #61dafb;
  border: none;
  padding: 12px 20px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: bold;
}

.input-box button:hover {
  background: #21a1f1;
}
